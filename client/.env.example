# Copia este archivo como ".env.local" y llena los dos valores
# (Supabase → Project Settings → API). Ese archivo NO se sube a ningún repositorio.
# Aquí solo va la clave PÚBLICA (anon / sb_publishable_...). NUNCA la secreta (service_role / sb_secret_...).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_TU-CLAVE-PUBLICA
# Guardar las fotos de evidencias en Google Drive (requiere publicar la función "drive"; ver supabase/DRIVE.md)
VITE_USAR_DRIVE=false
